# --- Docker Database (normal workflow) ---
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret123
DATABASE_NAME=graduation

# DATABASE_HOST / DATABASE_PORT are ONLY for running the backend OUTSIDE
# Docker against the published port (optional). Normal work happens fully
# inside Docker, where the backend always reaches Postgres at db:5432.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_HOST_PORT=5433

# --- Backend / security ---
APP_ENV=development
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
SQL_ECHO=false
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# --- SMTP (email OTP delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# عنوان الموقع العام لتحسين محركات البحث (يُستخدم وقت بناء الواجهة)
VITE_SITE_URL=http://localhost:5173
