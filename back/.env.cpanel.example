# Backend env vars for the cPanel deploy (Parahost, Python App "gradapi").
# Copy every var to the Setup Python App page. All secrets below are
# placeholders: generate real ones and never commit them.
#
# Special characters in passwords must be URL-encoded, e.g.
# @ -> %40, # -> %23, / -> %2F, : -> %3A

APP_ENV=production

# cPanel PostgreSQL: localhost:5432, database sunionhomsuni_graduation
DATABASE_URL=postgresql+asyncpg://sunionhomsuni_graduation_user:<url-encoded-password>@localhost:5432/sunionhomsuni_graduation

# cPanel Redis Server: port 51145, DB index 1 (never "Flush Database")
REDIS_URL=redis://:<url-encoded-password>@127.0.0.1:51145/1

# New random 64+ char string, e.g. openssl rand -hex 32 (never reuse an old one)
JWT_SECRET_KEY=<new random 64+ chars>

CORS_ORIGINS=https://sunion-homs-uni.sy

# cPanel mailbox, port 587 with STARTTLS (plain SMTP, no SSL on 465)
SMTP_HOST=mail.sunion-homs-uni.sy
SMTP_PORT=587
SMTP_USER=<mailbox@sunion-homs-uni.sy>
SMTP_PASSWORD=<mailbox password>
SMTP_FROM=<mailbox@sunion-homs-uni.sy>

SQL_ECHO=false

# URL prefix the Python App is mounted under; passenger_wsgi.py strips it
APP_URL_PREFIX=/gradapi

# Fail open on the auth token blacklist when Redis is down (default: false = fail closed)
AUTH_REDIS_FAIL_OPEN=true
# Small connection pool for shared-host PostgreSQL limits (default 20 / 10)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Uploaded university data files. Keep it OUTSIDE public_html (never
# web-reachable) and OUTSIDE the app root (so deploys don't touch it).
UNIVERSITY_FILES_DIR=/home/sunionhomsuni/graduation_storage/university_files
