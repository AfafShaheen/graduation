# Frontend env vars for the cPanel build (npm run build).
# Defaults equal local dev; these values are for the production sub-path deploy.

# The app lives under https://sunion-homs-uni.sy/graduation/
VITE_BASE_PATH=/graduation/

# Same-origin relative API base (no CORS); see docs/DEPLOY_CPANEL.md
VITE_API_URL=/gradapi

# Canonical URL used by the SEO plugin (no trailing slash here)
VITE_SITE_URL=https://sunion-homs-uni.sy/graduation

VITE_PREVIEW=false
