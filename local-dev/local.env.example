# Local development ONLY (Windows, no Docker). Never put production values here.
# setup_local.bat copies this file to local.env (git-ignored). Edit local.env, not this file.

APP_ENV=development

# PostgreSQL installed on Windows (default port 5432, user postgres).
# Put the password you chose in the PostgreSQL installer.
# The database name MUST end with _dev (the seed script refuses other names).
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/graduation_dev

# Redis for Windows (redis-server.exe) - see README.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DIR=C:\redis

# Any random string; local only.
JWT_SECRET_KEY=local-dev-only-change-me-0123456789abcdef

CORS_ORIGINS=https://localhost:5173,http://localhost:5173
UNIVERSITY_FILES_DIR=./storage/university_files
SQL_ECHO=false

# Empty SMTP = OTP codes are printed in the backend window instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
