+async def test_assign_seat_block_one_seat_per_graduate(
+    make_event, make_college, make_graduate, make_ticket, db
+):
+    """Two confirmed tickets with 2 and 3 companions get seats 1 and 2."""
+
+    event = await make_event(seat_prefix="E")
+    college = await make_college(event.id)
+    first = await make_graduate(college.id, university_id="930051")
+    second = await make_graduate(college.id, university_id="930052")
+    first_ticket = await make_ticket(first.id, event.id, companions_count=2)
+    second_ticket = await make_ticket(second.id, event.id, companions_count=3)
+
+    await assign_seat_block(db, first_ticket)
+    await assign_seat_block(db, second_ticket)
+    assert first_ticket.seat_start == 1
+    assert second_ticket.seat_start == 2
+
+    # With prefix E the labels are E-1 and E-2 (graduate only).
+    assert seat_labels("E", first_ticket.seat_start, 2) == {
+        "graduate": "E-1",
+        "companions": [],
+        "range": "E-1",
+    }
+    assert seat_labels("E", second_ticket.seat_start, 3) == {
+        "graduate": "E-2",
+        "companions": [],
+        "range": "E-2",
+    }
+    await db.commit()
+
+
